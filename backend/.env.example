# ==============================================================
# KisanRakshak AI — Backend Environment Configuration (.env)
# ==============================================================

# Server Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
SECRET_KEY=kisanrakshak-super-secret-jwt-key-2026-production

# Resend Email Verification (https://resend.com/api-keys)
# Step 1: Create an account on https://resend.com
# Step 2: Generate an API key starting with 're_' and paste below
RESEND_API_KEY=re_your_api_key_here
# Sender email: Use onboarding@resend.dev during testing
# or your verified domain in production (e.g. auth@kisanrakshak.in)
RESEND_FROM_EMAIL=KisanRakshak AI <onboarding@resend.dev>

# MongoDB Database Connection (Optional — in-memory fallback enabled)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/kisanrakshak?retryWrites=true&w=majority
DATABASE_NAME=kisanrakshak

# Google Gemini AI Vision & Diagnosis
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash

# Gnani.ai Indic Speech Services (Optional — multilingual fallbacks enabled)
GNANI_API_KEY=your-gnani-api-token

# Cloudinary Media Storage (https://cloudinary.com/console)
# Sign up on https://cloudinary.com for free cloud CDN storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Or use the single connection URL:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

